{#- Synthetic, abbreviated stand-in for a Granite 3.x template (<|tool_call|> JSON array). -#}
{%- if tools %}
{{- '<|start_of_role|>available_tools<|end_of_role|>' + (tools | tojson) + '<|end_of_text|>\n' }}
{%- endif %}
{%- for message in messages %}
{%- if message.role == 'user' %}
{{- '<|start_of_role|>user<|end_of_role|>' + message.content + '<|end_of_text|>\n' }}
{%- elif message.role == 'assistant' %}
{{- '<|start_of_role|>assistant<|end_of_role|>' + (message.content or '') }}
{%- if message.tool_calls %}
{{- '<|tool_call|>[' }}
{%- for tool_call in message.tool_calls %}
{%- set call = tool_call.function if tool_call.function is defined else tool_call %}
{{- '{"name": "' + call.name + '", "arguments": ' }}
{%- if call.arguments is string %}{{ call.arguments }}{% else %}{{ call.arguments | tojson }}{% endif %}
{{- '}' }}{% if not loop.last %}{{ ', ' }}{% endif %}
{%- endfor %}
{{- ']' }}
{%- endif %}
{{- '<|end_of_text|>\n' }}
{%- elif message.role == 'tool' %}
{{- '<|start_of_role|>tool<|end_of_role|>' + message.content + '<|end_of_text|>\n' }}
{%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}{{ '<|start_of_role|>assistant<|end_of_role|>' }}{% endif %}
