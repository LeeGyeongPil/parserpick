{#- Synthetic, abbreviated stand-in for a Kimi-K2-style template (section tokens). -#}
{%- if tools %}
{{- '<|im_system|>tool_declare<|im_middle|>' + (tools | tojson) + '<|im_end|>' }}
{%- endif %}
{%- for message in messages %}
{%- if message.role == 'user' %}
{{- '<|im_user|>user<|im_middle|>' + message.content + '<|im_end|>' }}
{%- elif message.role == 'assistant' %}
{{- '<|im_assistant|>assistant<|im_middle|>' + (message.content or '') }}
{%- if message.tool_calls %}
{{- '<|tool_calls_section_begin|>' }}
{%- for tool_call in message.tool_calls %}
{%- set call = tool_call.function if tool_call.function is defined else tool_call %}
{{- '<|tool_call_begin|>functions.' + call.name + ':' + (loop.index0 | string) + '<|tool_call_argument_begin|>' }}
{%- if call.arguments is string %}{{ call.arguments }}{% else %}{{ call.arguments | tojson }}{% endif %}
{{- '<|tool_call_end|>' }}
{%- endfor %}
{{- '<|tool_calls_section_end|>' }}
{%- endif %}
{{- '<|im_end|>' }}
{%- elif message.role == 'tool' %}
{{- '<|im_system|>tool<|im_middle|>## Return of ' + (message.name or '') + '\n' + message.content + '<|im_end|>' }}
{%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}{{ '<|im_assistant|>assistant<|im_middle|>' }}{% endif %}
