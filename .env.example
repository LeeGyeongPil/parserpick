# parserpick needs no API key and no GPU. Everything below is optional.

# UI language: en or ko (--lang wins over this; this wins over LC_ALL / LC_MESSAGES / LANG)
# PARSERPICK_LANG=en

# Bearer token for gated Hugging Face repos when you use hf:<org>/<repo> sources.
# Create one at https://huggingface.co/settings/tokens and keep it out of version control.
# HF_TOKEN=

# Hugging Face base URL or a mirror (default https://huggingface.co)
# HF_ENDPOINT=https://huggingface.co
